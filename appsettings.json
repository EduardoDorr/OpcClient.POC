{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "OpcUaWorkerService": "Debug"
    }
  },
  "OpcUa": {
    "Connection": {
      "EndpointUrl": "opc.tcp://EDUARDO-PC:53530/OPCUA/SimulationServer",
      "UseSecurity": false,
      "Security": {
        "CertificatePath": "",
        "CertificatePassword": "",
        "AutoAcceptUntrustedCertificates": true
      },
      "SessionTimeout": 60000,
      "ApplicationName": "OpcUaWorkerService",
      "ApplicationUri": "urn:localhost:OpcUaWorkerService"
    },
    "Variables": {
      "Read": [
        {
          "Name": "CycleStart",
          "NodeId": "ns=3;i=2000",
          "DataType": "Boolean"
        },
        {
          "Name": "CycleStop",
          "NodeId": "ns=3;i=2001",
          "DataType": "Boolean"
        }
      ],
      "Write": [
        {
          "Name": "ToWrite",
          "NodeId": "ns=3;i=2002",
          "DataType": "Boolean",
          "DefaultValue": "true"
        }
      ]
    }
  }
}
